# ── Database (Supabase Postgres) ────────────────
DATABASE_URL=postgresql://...              # Pooled connection (port 6543)
DIRECT_URL=postgresql://...               # Direct connection (port 5432, for migrations)

# ── Redis ───────────────────────────────────────
UPSTASH_REDIS_URL=                         # From upstash.com (free tier works)

# ── Steam ───────────────────────────────────────
STEAM_API_KEY=                             # From steamcommunity.com/dev/apikey

# ── App ─────────────────────────────────────────
JWT_SECRET=                                # Any random string, 32+ chars
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ── Phase 2+ (not needed yet) ──────────────────
# OPENAI_API_KEY=                          # For AI agents (Phase 2)
# CSFLOAT_API_KEY=                         # For CSFloat API auth (Phase 1C works without it for now)
